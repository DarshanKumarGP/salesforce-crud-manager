# From Salesforce: Setup > External Client App Manager > your app > Settings > OAuth Settings > Consumer Key and Secret
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Use https://test.salesforce.com for sandboxes, or your My Domain URL
SF_LOGIN_URL=https://login.salesforce.com
# Public URL of this app (no trailing slash). Callback = BASE_URL + /oauth/callback
BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3000
